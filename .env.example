# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real credentials.

# Required. PeerPesa API key used as the Bearer token on every request.
PEERPESA_API_KEY=sk_live_...

# Optional. Defaults to https://api.peerpesa.com/v1 if unset.
PEERPESA_BASE_URL=https://api.peerpesa.com/v1

# Optional. Sent as X-Client-Id header if set.
PEERPESA_CLIENT_ID=

# Optional. Per-request timeout in ms. Defaults to 15000.
PEERPESA_TIMEOUT_MS=15000

# --- Celo / Self Agent ID ---
# CELO_RPC_URL and AGENT_WALLET_PRIVATE_KEY are shared between:
#   - Self Agent ID registration (get_agent_identity / register_agent_identity)
#   - Celo DeFi swaps (execute_defi_swap)
# CELO_RPC_URL defaults to https://forno.celo.org if unset (public endpoint).
# Quotes (get_defi_quote) work without AGENT_WALLET_PRIVATE_KEY.
# Swaps (execute_defi_swap) require it — use a funded Celo wallet.
SELF_API_KEY=
CELO_RPC_URL=https://forno.celo.org
AGENT_WALLET_PRIVATE_KEY=0x...
SELF_AGENT_REGISTRY_ADDRESS=
